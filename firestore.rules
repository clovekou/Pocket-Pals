rules_version = '2';
// Pocket Pal — Firestore security rules. Paste these into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function unchanged(fields) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }

    // Public trainer profile: username, UID code, showcase of their team. Anyone signed in can view.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && request.resource.data.username is string
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        // the username claim is written in the same transaction, so check the state *after* it
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid
        && existsAfter(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
      // username and code can never change once chosen
      allow update: if isMe(uid) && unchanged(['username', 'usernameLower', 'code', 'createdAt']);
      allow delete: if false;
    }

    // Private game save — only the owner can read or write it.
    match /saves/{uid} {
      allow read, write: if isMe(uid);
    }

    // Unique usernames: one document per lower-cased name, can only be claimed once.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && name == name.lower() && name.matches('^[a-z0-9_]{3,16}$');
      allow update, delete: if false;
    }

    // Unique player IDs (like PP-7KX2M9QF): claimed once, never reused.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && code.matches('^PP-[A-Z0-9]{8}$');
      allow update, delete: if false;
    }

    // Friend requests: sender creates; only the receiver can accept/decline; either side can delete.
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.status in ['accepted', 'declined'] && unchanged(['from', 'to', 'fromName', 'fromCode']);
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Friendships: created by the person who accepted a request addressed to them.
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.to == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.from in request.resource.data.members;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    // Trades between two friends: only the two players can see or change it.
    match /trades/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2
        && request.resource.data.status == 'offered'
        && exists(/databases/$(database)/documents/friendships/$(request.resource.data.members[0] < request.resource.data.members[1]
             ? request.resource.data.members[0] + '_' + request.resource.data.members[1]
             : request.resource.data.members[1] + '_' + request.resource.data.members[0]));
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && unchanged(['members', 'from', 'to', 'offer', 'offerKey', 'fromName', 'toName']);
      allow delete: if false;
    }

    // Battle results, so the other player gets notified.
    match /battles/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && resource.data.to == request.auth.uid && unchanged(['members', 'from', 'to', 'winner']);
      allow delete: if false;
    }
  }
}
